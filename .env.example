# Banco de dados (Supabase / Postgres) — OPCIONAL.
# Sem esta variável, o app funciona normalmente com os dados estáticos de lib/data/.
# Com ela, as leituras no servidor passam a vir do banco.
#
# No Supabase: Project Settings → Database → Connection string (URI).
# Use a connection string "pooler" (porta 6543) para serverless na Vercel.
DATABASE_URL="postgresql://postgres:[SENHA]@[HOST]:6543/postgres?pgbouncer=true"

# Amadeus Self-Service API — fonte dos voos, horários e preços em /rotas.
# Chave gratuita em https://developers.amadeus.com (crie um app e copie o par).
# Sem estas variáveis a busca de voos não retorna nada, de propósito: é melhor
# não responder do que responder com rota que ninguém verificou.
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
# "test" (padrão) usa test.api.amadeus.com — cota mensal gratuita e malha
# reduzida. Use "production" quando o app estiver aprovado pela Amadeus.
AMADEUS_HOSTNAME="test"

# Admin (/admin protegido por Basic Auth). Defina nas variáveis da Vercel.
ADMIN_USER="admin"
ADMIN_PASSWORD="troque-esta-senha"
